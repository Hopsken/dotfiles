# Login Shell — PATH and tool environment setup.
# Sourced once for login shells. Universal vars belong in .zshenv.

# Path array keep unique entries only
typeset -U path

# 1. Homebrew
if [[ -x "/opt/homebrew/bin/brew" ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x "/usr/local/bin/brew" ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

# 2. Rust (Cargo)
[[ -d "$HOME/.cargo/bin" ]] && export PATH="$HOME/.cargo/bin:$PATH"

# 3. Go
if command -v go &>/dev/null || [[ -d "$HOME/.go/bin" ]]; then
  export GOPATH="${GOPATH:-$HOME/.go}"
  export PATH="$GOPATH/bin:$PATH"
fi

# 4. mise (runtime version manager)
command -v mise &>/dev/null && eval "$(mise activate zsh)"

# 5. Bun
export BUN_INSTALL="$HOME/.bun"
[[ -d "$BUN_INSTALL/bin" ]] && export PATH="$BUN_INSTALL/bin:$PATH"

# 6. uv / local bin
export PATH="$HOME/.local/bin:$PATH"

# 7. OrbStack
[[ -d "$HOME/.orbstack/bin" ]] && export PATH="$HOME/.orbstack/bin:$PATH"
