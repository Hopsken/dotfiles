# Login Shell — PATH and tool environment setup.
# Sourced once for login shells. Universal vars belong in .zshenv.

# Path array keep unique entries only
typeset -U path

# 1. Homebrew
if [[ -x "/opt/homebrew/bin/brew" ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x "/usr/local/bin/brew" ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

# 2. Rust (Cargo)
[[ -d "$HOME/.cargo/bin" ]] && export PATH="$HOME/.cargo/bin:$PATH"

# 3. Go (toolchain installed by mise; GOPATH holds `go install` binaries)
export GOPATH="${GOPATH:-$HOME/.go}"
[[ -d "$GOPATH/bin" ]] && export PATH="$GOPATH/bin:$PATH"

# 4. mise shims — for non-interactive/IDE login shells.
# Interactive shells get full activation in rc.d/05-mise.zsh.
command -v mise &>/dev/null && eval "$(mise activate zsh --shims)"

# 5. pnpm global bin
export PNPM_HOME="${PNPM_HOME:-$XDG_DATA_HOME/pnpm}"
[[ -d "$PNPM_HOME/bin" ]] && export PATH="$PNPM_HOME/bin:$PATH"

# 6. Bun
export BUN_INSTALL="$HOME/.bun"
[[ -d "$BUN_INSTALL/bin" ]] && export PATH="$BUN_INSTALL/bin:$PATH"

# 7. uv / local bin
export PATH="$HOME/.local/bin:$PATH"

# 8. OrbStack
[[ -d "$HOME/.orbstack/bin" ]] && export PATH="$HOME/.orbstack/bin:$PATH"
