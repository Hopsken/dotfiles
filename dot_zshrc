export LC_ALL=en_US.UTF-8
export EDITOR=vim
#export http_proxy="http://192.168.2.4:6152"
#export https_proxy="http://192.168.2.4:6152"

# Optional: also set uppercase variants for compatibility
#export HTTP_PROXY="$http_proxy"
