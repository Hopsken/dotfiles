{{- /* chezmoi:modify-template */ -}}
{{- /* Settings come entirely from this template; only lastChangelogVersion (written by pi at runtime) is kept from the existing file. */ -}}
{{- $managed := `{
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.5",
  "defaultThinkingLevel": "medium",
  "editorPaddingX": 0,
  "doubleEscapeAction": "tree",
  "packages": [
    "npm:pi-powerline-footer",
    {
      "source": "npm:@plannotator/pi-extension",
      "skills": []
    },
    "npm:pi-mcp-adapter",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@juicesharp/rpiv-i18n",
    "npm:pi-web-access",
    "npm:@narumitw/pi-goal",
    "npm:@tintinweb/pi-subagents"
  ],
  "powerline": "default",
  "quietStartup": true,
  "enabledModels": [
    "fireworks/accounts/fireworks/models/kimi-k2p6",
    "openai-codex/gpt-5.5",
    "openai-codex/gpt-5.3-codex"
  ],
  "theme": "dark",
  "terminal": {
    "showTerminalProgress": true
  }
}` | fromJson -}}
{{- $current := dict -}}
{{- if .chezmoi.stdin }}{{ $current = fromJson .chezmoi.stdin }}{{ end -}}
{{- if hasKey $current "lastChangelogVersion" }}{{ $managed = set $managed "lastChangelogVersion" $current.lastChangelogVersion }}{{ end -}}
{{- toPrettyJson $managed }}
