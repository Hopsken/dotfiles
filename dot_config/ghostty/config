# --- Fonts & Text ---
font-family = "Maple Mono NF CN"
font-size = 16
font-thicken = true

# --- Appearance & Theme ---
theme = Everforest Dark Hard
macos-icon = xray
background-opacity = 0.85
background-blur-radius = 40
window-padding-x = 8
window-padding-y = 8
macos-titlebar-style = transparent
shell-integration-features = no-cursor, sudo, ssh-terminfo, ssh-env

# --- Window Behavior ---
window-save-state = always
window-theme = auto
initial-window = true
quit-after-last-window-closed = true
confirm-close-surface = false

# --- Cursor ---
cursor-style = block
cursor-style-blink = true
cursor-opacity = 0.8

# --- Mouse & Clipboard ---
mouse-hide-while-typing = true
copy-on-select = clipboard
clipboard-paste-protection = true
clipboard-paste-bracketed-safe = true

# --- Quick Terminal ---
quick-terminal-position = top
quick-terminal-screen = mouse
quick-terminal-autohide = true
quick-terminal-animation-duration = 0.15

# --- Shell Integration & Execution ---
shell-integration = zsh
notify-on-command-finish = always

# --- Performance ---
scrollback-limit = 25000000

# --- Keybindings ---
keybind = shift+enter=text:\x1b\r
# Basic Split Screen
#keybind = cmd+d=new_split:right
#keybind = cmd+shift+enter=toggle_split_zoom
keybind = cmd+shift+f=toggle_split_zoom
keybind = cmd+shift+h=goto_split:left
keybind = cmd+shift+j=goto_split:down
keybind = cmd+shift+k=goto_split:up
keybind = cmd+shift+l=goto_split:right
keybind = global:cmd+grave_accent=toggle_quick_terminal
